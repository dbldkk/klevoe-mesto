[
  {
    "text": "Не жарь меня! У меня ипотека и сорок мальков!",
    "file": "0028a9b37e4dccdb.ogg",
    "speaker": "fish",
    "engine": "Chatterbox Multilingual 0.1.7",
    "reference": "built-in voice, no voice cloning"
  },
  {
    "text": "Лох, я бы тебя съела!",
    "file": "e4789bc489cc5e32.ogg",
    "speaker": "fish",
    "engine": "Chatterbox Multilingual 0.1.7",
    "reference": "built-in voice, no voice cloning"
  },
  {
    "text": "За Родину!",
    "file": "6ad0197df36810af.ogg",
    "speaker": "fish",
    "engine": "Chatterbox Multilingual 0.1.7",
    "reference": "built-in voice, no voice cloning"
  },
  {
    "text": "Гражданин, это убийство свидетеля! Штраф триста пятьдесят рублей.",
    "file": "e113424c1f1f1506.ogg",
    "speaker": "fish",
    "engine": "Chatterbox Multilingual 0.1.7",
    "reference": "built-in voice, no voice cloning"
  },
  {
    "text": "Фу! Вы там совсем обалдели? В озере же рыба!",
    "file": "e77e2be98dd37b8b.ogg",
    "speaker": "fish",
    "engine": "Chatterbox Multilingual 0.1.7",
    "reference": "built-in voice, no voice cloning"
  },
  {
    "text": "Кря! Предъявите улов! Я русалка при исполнении!",
    "file": "1481a9a870b94405.ogg",
    "speaker": "fish",
    "engine": "Chatterbox Multilingual 0.1.7",
    "reference": "built-in voice, no voice cloning"
  },
  {
    "text": "Ха-ха! Ведро тебе идёт! Почти депутат!",
    "file": "b9057914cfba908b.ogg",
    "speaker": "fish",
    "engine": "Chatterbox Multilingual 0.1.7",
    "reference": "built-in voice, no voice cloning"
  },
  {
    "text": "Ай! Я не мешок картошки!",
    "file": "c3e8aace4565df40.ogg",
    "speaker": "fish",
    "engine": "Chatterbox Multilingual 0.1.7",
    "reference": "built-in voice, no voice cloning"
  }
]