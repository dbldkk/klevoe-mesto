; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Клёвое место"
config/version="1.3.5"
config/use_custom_user_dir=true
config/custom_user_dir_name="Game fish"
run/main_scene="res://scenes/world.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")
config/icon="res://icon.svg"

[audio]

general/text_to_speech=true

[autoload]

Events="*res://scripts/autoload/events.gd"
Controls="*res://scripts/autoload/controls.gd"
GameData="*res://scripts/autoload/game_data.gd"
Saves="*res://scripts/autoload/saves.gd"
Inventory="*res://scripts/autoload/inventory.gd"
Icons="*res://scripts/autoload/icons.gd"
Sfx="*res://scripts/autoload/sfx.gd"
Settings="*res://scripts/autoload/settings.gd"
Net="*res://scripts/autoload/net.gd"

[display]

window/size/viewport_width=1600
window/size/viewport_height=900
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[layer_names]

3d_physics/layer_1="ground"
3d_physics/layer_2="water"
3d_physics/layer_3="invisible_walls"
3d_physics/layer_4="players_npc"
3d_physics/layer_5="interact"
3d_physics/layer_6="bottles"

[physics]

3d/physics_engine="Jolt Physics"

[rendering]

rendering_device/driver.windows="vulkan"
