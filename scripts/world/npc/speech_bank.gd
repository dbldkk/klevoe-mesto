class_name SpeechBank
## Живые реплики жителей посёлка: разговорный язык, характер, контекст.
## Callable, вернувший пустую строку, Chatter пропускает.


static func ctx() -> Dictionary:
	var d := {
		"hour": 12.0, "morning": false, "day": true, "evening": false, "night": false,
		"rain": false, "drunk": false, "wet": false, "stinky": false, "fish": false,
		"money": 0, "jailed": 0,
	}
	var tree := Engine.get_main_loop() as SceneTree
	if tree == null:
		return d
	var dc := tree.get_first_node_in_group("day_cycle") as DayCycle
	if dc:
		var h := fmod(dc.minutes / 60.0, 24.0)
		d["hour"] = h
		d["morning"] = h >= 5.0 and h < 11.0
		d["day"] = h >= 11.0 and h < 17.0
		d["evening"] = h >= 17.0 and h < 21.5
		d["night"] = h >= 21.5 or h < 5.0
	var w := tree.get_first_node_in_group("weather")
	if w and "state" in w:
		d["rain"] = int(w.state) >= 2
	var p := tree.get_first_node_in_group("local_player")
	if p:
		d["drunk"] = float(p.drunk) > 45.0
		d["stinky"] = float(p.stinky) > 0.0
		d["wet"] = bool(p.swimming) or Terrain.depth(p.global_position.x, p.global_position.z) > 0.25
	d["money"] = Inventory.money
	d["jailed"] = int(Inventory.stats.get("jailed", 0))
	d["fish"] = _has_fish()
	return d


static func _has_fish() -> bool:
	for s in Inventory.slots:
		if s != null and s.get("kind", "") == "fish":
			return true
	return false


static func _pick_ctx(c: Dictionary, rules: Array) -> String:
	for rule in rules:
		var key := String(rule[0])
		if key != "" and not bool(c.get(key, false)):
			continue
		return String(rule[1])
	return ""


